{
  "dashboard": {
    "id": null,
    "uid": "velocity-mcp",
    "title": "VELOCITY-MCP Dashboard",
    "tags": ["velocity", "mcp"],
    "timezone": "browser",
    "schemaVersion": 16,
    "version": 0,
    "refresh": "10s",
    "panels": [
      {
        "id": 1,
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
        "type": "stat",
        "title": "Total Requests",
        "targets": [
          {
            "expr": "sum(velocity_mcp_requests_total)",
            "legendFormat": "Total Requests"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "thresholds"},
            "thresholds": {
              "steps": [
                {"color": "green", "value": null},
                {"color": "yellow", "value": 1000},
                {"color": "red", "value": 10000}
              ]
            }
          }
        }
      },
      {
        "id": 2,
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
        "type": "stat",
        "title": "Success Rate",
        "targets": [
          {
            "expr": "sum(velocity_mcp_requests_successful) / sum(velocity_mcp_requests_total) * 100",
            "legendFormat": "Success Rate %"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "color": {"mode": "thresholds"},
            "thresholds": {
              "steps": [
                {"color": "red", "value": null},
                {"color": "yellow", "value": 90},
                {"color": "green", "value": 95}
              ]
            }
          }
        }
      },
      {
        "id": 3,
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
        "type": "graph",
        "title": "Request Rate",
        "targets": [
          {
            "expr": "rate(velocity_mcp_requests_total[5m])",
            "legendFormat": "Requests/sec"
          }
        ],
        "yaxes": [
          {"format": "reqps", "label": null},
          {"format": "short", "label": null}
        ]
      },
      {
        "id": 4,
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
        "type": "graph",
        "title": "Error Rate",
        "targets": [
          {
            "expr": "rate(velocity_mcp_requests_failed[5m])",
            "legendFormat": "Errors/sec"
          }
        ],
        "yaxes": [
          {"format": "reqps", "label": null},
          {"format": "short", "label": null}
        ]
      },
      {
        "id": 5,
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16},
        "type": "graph",
        "title": "Active Sessions",
        "targets": [
          {
            "expr": "velocity_mcp_sessions_active",
            "legendFormat": "Active Sessions"
          }
        ],
        "yaxes": [
          {"format": "short", "label": null},
          {"format": "short", "label": null}
        ]
      },
      {
        "id": 6,
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16},
        "type": "graph",
        "title": "Rate Limit Hits",
        "targets": [
          {
            "expr": "rate(velocity_mcp_rate_limit_hits_total[5m])",
            "legendFormat": "Rate Limit Hits/sec"
          }
        ],
        "yaxes": [
          {"format": "ops", "label": null},
          {"format": "short", "label": null}
        ]
      },
      {
        "id": 7,
        "gridPos": {"h": 8, "w": 24, "x": 0, "y": 24},
        "type": "table",
        "title": "Plugin Statistics",
        "targets": [
          {
            "expr": "velocity_mcp_plugins_total",
            "legendFormat": "Total Plugins",
            "format": "table",
            "instant": true
          },
          {
            "expr": "velocity_mcp_plugins_installed",
            "legendFormat": "Installed Plugins",
            "format": "table",
            "instant": true
          }
        ]
      }
    ],
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "timepicker": {
      "refresh_intervals": ["5s", "10s", "30s", "1m", "5m", "15m", "30m", "1h", "2h", "1d"]
    }
  },
  "overwrite": true
}
