{
  "name": "wasm-perl-tools",
  "version": "1.0.0",
  "tools": [
    {
      "name": "perl_greet",
      "description": "Greeting tool powered by the Perl/WASM interpreter. Accepts a name argument and returns a personalized greeting.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Name to greet"
          }
        },
        "required": ["name"]
      },
      "executor": {
        "executor_type": "wasm",
        "language": "perl",
        "source": "set_tool_result(\"Hello, \" . $name . \"!\");",
        "timeout": 5
      }
    }
  ]
}
