{
  "name": "wasm-php-tools",
  "version": "1.0.0",
  "tools": [
    {
      "name": "php_greet",
      "description": "Greeting tool powered by the PHP/WASM interpreter. Accepts a name argument and returns a personalized greeting.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Name to greet"
          }
        },
        "required": ["name"]
      },
      "executor": {
        "executor_type": "wasm",
        "language": "php",
        "source": "<?php return \"Hello, $name!\";",
        "timeout": 5
      }
    }
  ]
}
