{
  "name": "wasm-r-tools",
  "version": "1.0.0",
  "tools": [
    {
      "name": "r_greet",
      "description": "Greeting tool powered by the R/WASM interpreter. Accepts a name argument and returns a personalized greeting.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Name to greet"
          }
        },
        "required": ["name"]
      },
      "executor": {
        "executor_type": "wasm",
        "language": "r",
        "source": "return(\"Hello, {name}!\")",
        "timeout": 5
      }
    }
  ]
}
